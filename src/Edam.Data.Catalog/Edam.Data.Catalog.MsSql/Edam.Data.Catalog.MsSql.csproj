<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edam.Data.Catalog.Contracts\Edam.Data.Catalog.Contracts.csproj" />
  </ItemGroup>

  <!-- LM-8: the MS-SQL peer of Edam.Data.Catalog.PostgreSql. Microsoft.Data.SqlClient is the modern
       client (the legacy System.Data.SqlClient is what Edam.System still uses); 5.1.6 is the version the
       Studio's NuGet Audit already pins, and it is present in the local cache, so no network is needed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
