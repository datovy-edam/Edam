    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.OpenApi package removed: unused. The hosted catalog map
         (CatalogServiceMap/WebAppService) uses WebApplication, supplied by the framework
         reference below (not the OpenApi package). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edam.Data.Catalog.Contracts\Edam.Data.Catalog.Contracts.csproj" />
    <!-- Edam.Data.CatalogDb removed (BL-7.2 step 4): the catalog HTTP clients now
         deserialize Contracts value records and the file-system client uses the
         pure-Model ModelCatalogService default. No CatalogDb reference remains. -->
    <ProjectReference Include="..\Edam.Data.CatalogModel\Edam.Data.CatalogModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Edam.Libraries\System\Edam.System\Edam.System.csproj" />
    <ProjectReference Include="..\..\Edam.Libraries\System\Edam.Net\Edam.Net.csproj" />
  </ItemGroup>

</Project>
