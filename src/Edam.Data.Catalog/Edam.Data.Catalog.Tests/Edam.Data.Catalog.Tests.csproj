    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edam.Data.Catalog.Contracts\Edam.Data.Catalog.Contracts.csproj" />
    <ProjectReference Include="..\Edam.Data.Catalog.FileSystem\Edam.Data.Catalog.FileSystem.csproj" />
    <ProjectReference Include="..\Edam.Data.Catalog.PostgreSql\Edam.Data.Catalog.PostgreSql.csproj" />
    <ProjectReference Include="..\Edam.Data.Catalog.DependencyInjection\Edam.Data.Catalog.DependencyInjection.csproj" />
    <ProjectReference Include="..\Edam.Data.Catalog.Conformance\Edam.Data.Catalog.Conformance.csproj" />
    <ProjectReference Include="..\Edam.Data.CatalogServiceClient\Edam.Data.CatalogServiceClient.csproj" />
  </ItemGroup>

</Project>
