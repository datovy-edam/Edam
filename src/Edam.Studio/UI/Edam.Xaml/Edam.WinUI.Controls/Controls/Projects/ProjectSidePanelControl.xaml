<UserControl
    x:Class="Edam.WinUI.Controls.Projects.ProjectSidePanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctk="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:Edam.WinUI.Controls.DataModels"
    xmlns:cnv="using:Edam.WinUI.Controls.Common"
    xmlns:local="using:Edam.WinUI.Controls.Projects"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

   <UserControl.Resources>
      <cnv:FolderFileIconConverter x:Key="FileConverter" />
   </UserControl.Resources>

   <Grid>
      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      
      <CommandBar Grid.Column="0" Grid.Row="0" Margin="14,0,0,0" HorizontalAlignment="Left" Padding="0" Height="40">
         <AppBarButton Click="ProjectRefresh_Click" 
                       Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Bold"
                       ToolTipService.ToolTip="Refresh Projects List" Content="PROJECTS" Height="64"/>
         <AppBarButton Click="ProjectAdd_Click" Background="Transparent" BorderThickness="0" Width="26"
                       ToolTipService.ToolTip="Add New Project" Icon="Add" Height="64" />
      </CommandBar>

      <!-- the container selector, with ONE manager button beside it: "where does the catalog store my data?",
           and add / describe / remove a container — must be answerable FROM the application, not by reading
           configuration (LM-9 / ADR-0014 decision 8). The button carries no border, by design. -->
      <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="8,0,8,0">
         <ComboBox ItemsSource="{x:Bind ViewModel.UriItems, Mode=TwoWay}" MinWidth="150"
                  SelectedItem="{x:Bind ViewModel.SelectedUriItem, Mode=TwoWay}"
                  ToolTipService.ToolTip="Select the catalog container the projects live in"
                  DisplayMemberPath="Name" />
         <Button x:Name="ContainerManagerButton" Click="ContainerManager_Click" Padding="8,0,8,0"
                 Background="Transparent" BorderThickness="0"
                 FontFamily="Segoe MDL2 Assets" Content="&#xE713;"
                 ToolTipService.ToolTip="Containers — review, add, describe, remove; and where the catalog stores the data" />
      </StackPanel>

      <!-- DP-1: the empty state. A fresh installation has no projects and an empty TreeView explains
           nothing, so say what is true and offer the one action that helps. It reuses the panel's own
           Add handler, so there is no new write path and no new gate. When the tree could not be LOADED
           the same area says so instead (a storage problem is a diagnostic, never a silent "no projects
           yet") and the create action is hidden, because it could not work either. -->
      <StackPanel Grid.Column="0" Grid.Row="2" Margin="16,28,16,0" Spacing="6"
                  VerticalAlignment="Top"
                  Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
         <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" />
         <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                    Text="{x:Bind ViewModel.EmptyStateText, Mode=OneWay}" />
         <Button Content="Create a project" Margin="0,6,0,0" Click="ProjectAdd_Click"
                  Visibility="{x:Bind ViewModel.EmptyStateActionVisibility, Mode=OneWay}" />
      </StackPanel>

      <TreeView ScrollViewer.VerticalScrollMode="Auto" Grid.Column="0" Grid.Row="2" Margin="0"
               x:Name="TreeView" Background="#F9F9F9" VerticalAlignment="Stretch" Padding="0"
               ItemsSource="{x:Bind ViewModel.TreeView.Children, Mode=TwoWay}"
               SelectionMode="Single">
            <TreeView.ItemTemplate>
               <DataTemplate x:DataType="models:ProjectItem">
                  <TreeViewItem Padding="0,0,10,0" ItemsSource="{x:Bind Children, Mode=TwoWay}" 
                                   KeyDown="TreeViewItem_KeyDown"
                                   PointerPressed="TreeViewItem_PointerPressed">
                     <TreeViewItem.ContextFlyout>
                        <MenuFlyout>
                           <MenuFlyoutItem Text="Edit" Icon="Edit" Click="TreeItemEdit_Click" />
                           <MenuFlyoutItem Text="Copy" Icon="Copy" Click="TreeItemCopy_Click" />
                           <MenuFlyoutItem Text="Add Items" Icon="Add" Click="TreeAddItems_Click" />
                           <MenuFlyoutSeparator/>
                           <MenuFlyoutItem Text="Delete" Icon="Delete" Click="TreeItemDelete_Click" />
                        </MenuFlyout>
                     </TreeViewItem.ContextFlyout>
                     <StackPanel>
                        <StackPanel Orientation="Horizontal" 
                                    Visibility="{x:Bind TextVisibility, Mode=TwoWay}">
                           <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{x:Bind Item.Type,
                                     Converter={StaticResource FileConverter}}" />
                           <TextBlock x:Name="ItemText" Margin="6,0,0,0" Text="{x:Bind Item.NameFull}"
                                      PointerPressed="ItemText_PointerPressed"  DoubleTapped="TextBlock_DoubleTapped" />
                        </StackPanel>
                        <TextBox x:Name="ItemTextEdit" Text="{x:Bind SelectedText, Mode=TwoWay}"
                                 KeyDown="ItemTextEdit_KeyDown"  Visibility="{x:Bind TextEditorVisibility, Mode=TwoWay}"/>
                     </StackPanel>
                  </TreeViewItem>
               </DataTemplate>
            </TreeView.ItemTemplate>
         </TreeView>
      
   </Grid>
</UserControl>
