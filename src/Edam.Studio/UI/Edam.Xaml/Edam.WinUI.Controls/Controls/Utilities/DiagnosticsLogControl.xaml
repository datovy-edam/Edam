<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Edam.WinUI.Controls.Utilities.DiagnosticsLogControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Edam.WinUI.Controls.Controls.Utilities"
    xmlns:viewmodels="using:Edam.WinUI.Controls.ViewModels"
    xmlns:cnv="using:Edam.WinUI.Controls.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

   <UserControl.Resources>
      <!-- the KIND of a message is visible before its words: navy = information, dark goldenrod = warning,
           brown = error/exception, dark red = critical, grey = debug noise -->
      <cnv:SeverityLevelBrushConverter x:Key="SeverityBrush" />
   </UserControl.Resources>

   <Grid>
      <!-- the log must FILL the width it is given: an Auto column (and a ListView, which has no
           intrinsic width while empty) collapsed this panel to nothing, so it appeared never to open -->
      <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
         <!-- Auto, not a fixed height: the strip is exactly as tall as its (centred) content, so the icons
              can never sit off-centre or crowd the bottom edge of the panel -->
         <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Background="#fbfbfb" BorderBrush="LightGray" BorderThickness="1"
             Orientation="Horizontal" VerticalAlignment="Center"
             Padding="4,3,4,3"
             Grid.Row="0" Grid.Column="0">
         <!-- Plain buttons with a FontIcon, not AppBarButtons: an AppBarButton's template reserves room for a
              label (even when collapsed) and centres the glyph inside THAT, which is why the icons were
              sitting low. A button with an explicit glyph is centred by construction. -->
         <Button Click="ClearViewButton_Click" Width="28" Height="28" Padding="0"
                 Background="Transparent" BorderThickness="0"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                 ToolTipService.ToolTip="Clean all entries">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE894;" FontSize="12"/>
         </Button>
         <Button Click="CopySelectedButton_Click" Width="28" Height="28" Padding="0"
                 Background="Transparent" BorderThickness="0"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                 IsEnabled="{x:Bind m_ViewModel.HasSelection, Mode=OneWay}"
                 ToolTipService.ToolTip="Copy the SELECTED messages to the clipboard">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8C8;" FontSize="12"/>
         </Button>
         <Button Click="CopyAllButton_Click" Width="28" Height="28" Padding="0"
                 Background="Transparent" BorderThickness="0"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                 ToolTipService.ToolTip="Copy every message to the clipboard">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8B3;" FontSize="12"/>
         </Button>
         <!-- silent while nothing is ticked, so the strip stays quiet: the count appears when it means something -->
         <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11" Foreground="Gray"
                    Text="{x:Bind m_ViewModel.CopySelectionText, Mode=OneWay}"/>
      </StackPanel>

      <!-- SelectionMode=None so a click/drag goes to the entry's text (selecting to copy) rather than
           selecting the list row -->
      <ListView ItemsSource="{x:Bind m_ViewModel.Items}" VerticalAlignment="top" 
             HorizontalAlignment="Stretch"
             SelectionMode="None" IsItemClickEnabled="False"
             ScrollViewer.VerticalScrollBarVisibility="Visible"
             ScrollViewer.VerticalScrollMode="Auto"
             ScrollViewer.HorizontalScrollMode="Auto" CanBeScrollAnchor="True"
             BorderBrush="LightGray" BorderThickness="1"
             Grid.Row="1" Grid.Column="0"
             >
         <ListView.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:DiagnosticsEntry">
               <StackPanel Padding="2,2,2,2">
                  <!-- the tick and the timestamp share ONE line, in a Grid whose children are BOTH centred:
                       that is what keeps the tick, the text and the band itself vertically aligned instead of
                       floating high or low inside the row -->
                  <Grid>
                     <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                     </Grid.ColumnDefinitions>
                     <CheckBox Grid.Column="0" Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                               Margin="0,0,4,0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                               IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                               ToolTipService.ToolTip="Tick to copy this message on its own"/>
                     <TextBox Grid.Column="1" Text="{x:Bind LoggedDateTimeText}" IsReadOnly="True"
                              BorderThickness="0" Background="Transparent" Padding="0"
                              MinHeight="0" FontSize="10" Foreground="Gray"
                              VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                  </Grid>
                  <TextBox Text="{x:Bind ErrorMessage}" IsReadOnly="True"
                           TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                           Padding="0" MinHeight="0" Margin="24,0,0,0" FontSize="12"
                           Foreground="{x:Bind Severity, Converter={StaticResource SeverityBrush}}"
                           IsSpellCheckEnabled="False"/>
                  <!-- right-click a message: copy exactly it, without touching the ticks -->
                  <StackPanel.ContextFlyout>
                     <MenuFlyout>
                        <MenuFlyoutItem Text="Copy this message" Tag="{Binding}" Click="CopyEntry_Click"/>
                        <MenuFlyoutItem Text="Copy selected messages" Click="CopySelectedButton_Click"/>
                     </MenuFlyout>
                  </StackPanel.ContextFlyout>
               </StackPanel>
            </DataTemplate>
         </ListView.ItemTemplate>
      </ListView>
   </Grid>
   
</UserControl>
