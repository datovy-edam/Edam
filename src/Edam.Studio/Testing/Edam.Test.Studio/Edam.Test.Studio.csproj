<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>Edam.Test.Studio</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <UseWinUI>true</UseWinUI>
    <!-- Tests carry no XAML/PRI resources; disable PRI generation so the build
         does not require an additional UAP SDK folder. -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <!-- Security pins (dependency hygiene): the vulnerable packages reach this project
         transitively through the Edam.* feed packages / EF Core 6.x; direct references override
         them. Fixed versions available offline.
           Microsoft.Data.SqlClient 2.1.4              high     GHSA-98g6-xh36-x2p7 -> 5.1.6
           Microsoft.Extensions.Caching.Memory 6.0.1    high     GHSA-qj66-m88j-hmgj -> 10.0.0
           System.Drawing.Common 4.7.0                  critical GHSA-rxg9-xrhp-64gj -> 6.0.0
           System.IdentityModel.Tokens.Jwt 6.8.0        moderate GHSA-59j7-ghrg-fj52 -> 8.19.2
           Microsoft.IdentityModel.JsonWebTokens 6.8.0  moderate GHSA-59j7-ghrg-fj52 -> 8.19.2
         STILL PENDING: SQLitePCLRaw.lib.e_sqlite3 2.0.4 (high, GHSA-2m69-gcr7-jv3q) - the fixed
         version is not in the offline cache (see HANDOFF). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.6" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UI\Edam.Xaml\Edam.WinUI.Controls\Edam.WinUI.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
