<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The composition root is allowed to name providers (that is its job): it wires the
         contracts to a file-system or a catalog-backed implementation. -->
    <ProjectReference Include="..\Edam.Data.Projects.Contracts\Edam.Data.Projects.Contracts.csproj" />
    <ProjectReference Include="..\Edam.Data.Projects.FileSystem\Edam.Data.Projects.FileSystem.csproj" />
    <ProjectReference Include="..\Edam.Data.Projects.Catalog\Edam.Data.Projects.Catalog.csproj" />
    <ProjectReference Include="..\Edam.Data.Projects.Runner\Edam.Data.Projects.Runner.csproj" />
    <!-- For the catalog target the catalog composition root supplies ICatalogStore/IContentStore. -->
    <ProjectReference Include="..\..\Edam.Data.Catalog\Edam.Data.Catalog.DependencyInjection\Edam.Data.Catalog.DependencyInjection.csproj" />
    <!-- The settings vocabulary (tier · kind · apply scope · section) the registry declares per item, so a
         settings surface is generated from the registry instead of being hardcoded (ADR-0016). Contract-only:
         no behavior, no UI, no storage. -->
    <ProjectReference Include="..\..\Edam.Settings\Edam.Settings.Contracts\Edam.Settings.Contracts.csproj" />
    <!-- The one settings service (read → change → apply) that every host drives, so no surface re-implements
         "store it and make it real" (ADR-0016). -->
    <ProjectReference Include="..\..\Edam.Settings\Edam.Settings.Core\Edam.Settings.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <!-- Arguments-file validation (the Projects specification §2.3): NJsonSchema is MIT-licensed and already in
         this repository, while the Newtonsoft.Json.Schema references elsewhere are AGPL-3.0/commercial dual. -->
    <PackageReference Include="NJsonSchema" Version="10.9.0" />
  </ItemGroup>

</Project>
